<template>
  <view class="absolute top-0 left-0 w-full h-full min-h-screen bg-gray-50 dark:bg-black text-gray-900 dark:text-white flex flex-col justify-between" :style="refreshHeightStyle">
    
    <!-- 顶部固定导航区 -->
    <view class="w-full absolute top-0 left-0 z-50 pointer-events-none">
        <!-- 毛玻璃背景 -->
        <view v-if="!hideBg" class="absolute top-0 left-0 w-full backdrop-blur-base bg-gray-50/80 dark:bg-black/80" :style="{ height: (layout.navBarTop + layout.navBarHeight + 5) + 'px' }">
        </view>

        <!-- 导航内容交互行 -->
        <view class="w-full flex flex-row items-center pointer-events-none" :style="{ height: (layout.navBarTop + layout.navBarHeight + layout.navBarTop) + 'px' }">
            <view class="relative w-full z-20 flex flex-row items-center gap-x-2 shrink-0 pointer-events-none" :style="{ height: (layout.navBarTop + layout.navBarHeight + layout.navBarTop) + 'px' }">
                
                <slot name="navbar">
                      <view class="relative z-20 flex flex-row items-center shrink-0 px-4 pointer-events-none">

                      <scale-card :class="showBack||showClose ? 'dropdown-pop-base mr-2' : '!w-0'"  @click="handleBack" class="block shrink-0 w-8 h-8 rounded-full overflow-hidden flex items-center justify-center pointer-events-auto text-gray-700 dark:text-neutral-200">
                        <svg-icon :size="14" class="shrink-0"><text :class="[showBack ? 'i-[mingcute--arrow-left-line]' : 'i-[mingcute--close-line]', 'size-[14px]', 'current-color']"></text></svg-icon>
                      </scale-card>
                      </view>
                      <!-- 中间标题 -->
                      <view class="absolute w-full h-full z-10 left-0 right-0 px-1 flex flex-row items-center justify-center pointer-events-auto">
                          <text class="text-base font-bold text-gray-900 dark:text-neutral-100 truncate max-w-[50%]">{{ title }}</text>
                      </view>
                      <!-- 右侧占位 -->
                      <view></view>
                </slot>
            </view>
        </view>
    </view>

    <!-- 中间主体内容区 -->
    <view class="w-full h-full flex-1">
        <slot></slot>
    </view>

    <!-- 全局通用弹窗 -->
    <cl-popup
      v-model="popupVisible"
      :direction="popupDirection"
      :size="popupSize"
      :swipe-close="true"
      :mask-closable="true"
      :show-header="popupShowHeader"
      :show-close="false"
      :pt="{ 
        header: { className: '!h-8' },
        inner: { className: popupRadiusClass + ' overflow-hidden !bg-white dark:!bg-neutral-900' }
        }"
    >
      <view class="w-full h-full bg-white dark:bg-neutral-900 overflow-hidden" :class="popupRadiusClass">
        <slot name="popup-content"></slot>
      </view>
    </cl-popup>

    <!-- 右下角悬浮按钮区 -->
    <view class="absolute bottom-30 right-6 z-40 flex flex-col gap-y-2">
        <scale-card
            v-if="showBackTop && hasFab('backtop')"
            @click="onBackTopClick"
            class="w-10 h-10 bg-gray-900 dark:bg-neutral-100 rounded-full flex items-center justify-center active-click-base dropdown-pop-base"
        >
          <svg-icon :size="16"><text class="i-[mingcute--arrow-to-up-line] text-white dark:text-black size-[16px]"></text></svg-icon>
        </scale-card>
        <scale-card v-if="hasFab('pub')" @click="openAction" class="w-10 h-10 bg-gray-900 dark:bg-neutral-100 rounded-full flex items-center justify-center active-click-base dropdown-pop-base">
          <svg-icon :size="16"><text class="i-[mingcute--add-fill] text-white dark:text-black size-[16px]"></text></svg-icon>
        </scale-card>
    </view>

  </view>
</template>

<script setup lang="uts">
import { ref, computed } from 'vue'
import { themeState } from '@/stores/theme.uts'
import { router } from '@/.cool'

const props = defineProps({
  title: { type: String, default: '' },
  showBack: { type: Boolean, default: false },
  showClose: { type: Boolean, default: false },
  homePath: { type: String, default: '/pages/index/index' },
  showBackTop: { type: Boolean, default: false },
  showFabs: { type: Array, default: () => [] },
  hideBg: { type: Boolean, default: false }
})

const layout = computed(() => themeState.layout)
const emit = defineEmits(['back-to-top', 'open-action', 'back-click'])

const refreshHeightStyle = computed(() : string => {
  const currentLayout = layout.value
  const headerHeight = currentLayout != null ? currentLayout.headerHeight : 0
  const val = headerHeight
  return `--refreshheight:${val}px`
})

const hasFab = (name : string) : boolean => {
  const fabs = props.showFabs as string[]
  if (fabs != null && Array.isArray(fabs)) {
    return fabs.includes(name)
  }
  return false
}

const handleBack = () => {
  console.log('handleBack')
  router.back()
}

// 弹窗控制
const popupVisible = ref(false)
const popupDirection = ref('left')
const popupSize = ref('75%')       
const popupShowHeader = ref(false)

const openPopup = (direction : string = 'left', size : string = '75%', showHeader : boolean = false) => {
  popupDirection.value = direction
  popupSize.value = size
  popupVisible.value = true
  popupShowHeader.value = showHeader
}

const closePopup = () => {
  popupVisible.value = false
}

const onBackTopClick = () => {
  emit('back-to-top')
}

const openAction = () => {
  emit('open-action')
}

// 智能计算圆角类名
const popupRadiusClass = computed(() : string => {
  const dir = popupDirection.value
  const size = String(popupSize.value)

  // 1. 如果是居中弹窗，直接四周圆角
  if (dir == 'center') {
    return 'rounded-2xl'
  }

  // 2. 如果尺寸是 100%（全屏铺满），则不需要圆角
  if (size == '100%' || size == '100vw' || size == '100vh') {
    return 'rounded-none'
  }

  // 3. 根据不同的弹出方向，给对应的边缘加上圆角
  switch (dir) {
    case 'bottom':
      return 'rounded-t-2xl' // 底部弹出：上方两角圆角
    case 'top':
      return 'rounded-b-2xl' // 顶部弹出：下方两角圆角
    case 'left':
      return 'rounded-r-2xl' // 左侧弹出：右侧两角圆角（正如你的侧滑菜单）
    case 'right':
      return 'rounded-l-2xl' // 右侧弹出：左侧两角圆角
    default:
      return 'rounded-2xl'
  }
})

defineExpose({ openPopup, closePopup })
</script>