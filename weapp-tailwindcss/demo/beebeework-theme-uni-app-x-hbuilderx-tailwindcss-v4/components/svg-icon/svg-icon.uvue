<template>
  <view 
    class="relative overflow-hidden shrink-0 flex items-center justify-center" 
    :style="{ width: outerSize + 'px', height: outerSize + 'px' }"
    hover-class="none"
  >

    <view class="absolute shrink-0 w-full h-full flex items-center justify-center" style="left:-0.3px;top:-0.3px;"
     :style="{ width: size + 'px', height: size + 'px' }">
      <slot style="transform: translateZ(0);will‑change: transform;" />
    </view>
  </view>
</template>

<script setup>
import { computed } from 'vue'

const props = defineProps({
  size: { type: [Number, String], default: 24 }
})

const outerSize = computed(() => {
  const num = parseFloat(String(props.size)) || 24
  return num - 0.6
})
</script>