<template>
  <scroll-view type="custom" scroll-x="true" class="w-full mt-2 pt-3 h-20"
  :show-scrollbar="false">
  <view class="flex flex-row gap-x-3 justify-between flex-nowrap">
      <view v-for="(stat, sIndex) in statsList" 
        :key="sIndex"
        :class="[
          statsList.length === 1 ? 'w-full' : 
          statsList.length === 2 ? 'w-1/2' : 
          statsList.length === 3 ? 'w-1/3' : 
          statsList.length === 4 ? 'w-1/4' : '',
          'flex flex-col shrink-0 px-2',
          sIndex === 0 ? 'pl-5' : '',
          sIndex === statsList.length - 1 ? 'pr-5' : ''
        ]"
         @click="onMenuClick(stat.name)">
        <text class="w-full text-neutral-400 dark:text-neutral-600 text-sm">{{stat.name}}</text>
        <view class="text-base font-bold text-neutral-900 dark:text-neutral-300 flex flex-row items-center gap-x-1 shrink-0 h-6">
          <view class="relative h-full flex flex-row items-center">
          <text class="text-base font-bold">{{stat.value}}</text>
          </view>
          <svg-icon :size="16"><text class="i-[mingcute--right-line] shrink-0 size-[16px] text-neutral-400"></text></svg-icon>
        </view>
      </view> </view>
  </scroll-view>
</template>

<script setup>
import { computed } from 'vue'

const props = defineProps({
  data: { type: Object, default: () => ({}) }
})

const statsList = computed(() => props.data?.statsList || [])

const onMenuClick = (title) => {
  uni.showToast({ title: `点击了: ${title}`, icon: 'none' })
}

</script>