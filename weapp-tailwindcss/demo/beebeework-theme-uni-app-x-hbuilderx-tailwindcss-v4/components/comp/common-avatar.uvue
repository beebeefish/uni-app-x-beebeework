    default: () => ({})
  }
})

const emit = defineEmits(['close', 'select'])

// 直接从全局缓存的 themeState 中获取配置好的 addActionList
const addActionList = computed(() => {
  return themeState.addActionList || []
})

const onSelect = (subItem) => {
  if (subItem.path) {
    // 自动处理路径拼接、tabBar判断、参数传递
    router.push({ path: subItem.path })
  }
  
  // 默认点击后自动关闭弹窗
  emit('close')
}
