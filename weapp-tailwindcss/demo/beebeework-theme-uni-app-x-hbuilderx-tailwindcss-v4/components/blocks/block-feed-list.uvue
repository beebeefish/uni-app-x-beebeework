<template>
  <view class="flex p-4 flex-col gap-3 mb-1">
    <!-- 模块小标题 -->
    <text v-if="title" class="text-base font-bold px-1 -mb-1 -mt-4">{{ title }}</text>
    
    <view 
      v-for="(item, index) in data" 
      :key="index"
      @click="$emit('item-click', item)"
      class="dropdown-pop-base rounded-3xl p-4 flex flex-col gap-4 active:scale-[0.99] transition-all"
    >
      <!-- 头部：作者与时间 -->
      <view class="flex flex-row items-center justify-between">
        <view class="flex flex-row items-center gap-x-2.5" @click.stop="$emit('avatar-click', item)">
          <image :src="item.avatar" class="w-9 h-9 rounded-full bg-gray-200 dark:bg-neutral-800 object-cover" mode="aspectFill" />
          <view class="flex flex-1 flex-col gap-y-0.5">
            <text class="text-sm font-bold text-gray-800 dark:text-neutral-200">{{ item.nickname }}</text>
            <view class="flex flex-row flex-wrap gap-1 min-h-4 items-center">
              <text v-if="item.role && item.role !==''" class="rounded-sm h-4 px-1 flex justify-center items-center orange-btn text-[0.625rem] cursor-default">{{ item.role }}</text>
              <view class="relative">
                <view class="rounded-sm flex flex-row justify-center items-center">
                  <view class="rounded-sm text-[0.625rem] border border-gray-300/50 h-4 flex flex-row justify-center items-center relative overflow-hidden">
                    <text v-if="item.niceid" class="h-[1.125rem] -mt-[0.0625rem] text-[#FFDFBA] bg-neutral-800 flex flex-row items-center px-1 relative z-[2]">靓</text>
                    <text v-if="item.niceid" class="absolute left-[0.75rem] w-2 h-[140%] bg-neutral-800 [transform:rotate(15deg)] z-[1]"></text>
                    <text class="text-[0.625rem] text-neutral-500 cursor-default px-1">{{item.level}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <text class="text-[11px] text-gray-400 dark:text-neutral-500">{{ item.time }}</text>
      </view>
      <!-- 内容文本 -->
      <text class="text-xs text-gray-600 dark:text-neutral-300 leading-relaxed">{{ item.content || item.summary }}</text>
    </view>
  </view>
</template>

<script setup>
defineProps({
  title: { type: String, default: '' },
  data: { type: Array, default: () => [] }
})
defineEmits(['item-click', 'avatar-click'])
</script>